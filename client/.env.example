# Leave unset to use the Vite dev proxy (/api → http://localhost:5000).
# Set only when the API is hosted on a different origin.
# VITE_API_URL=https://api.example.com/api

# Dev proxy target (optional)
# VITE_PROXY_TARGET=http://localhost:5000

# Skip downloading the computer-vision models during npm install (CDN is used at runtime instead)
# MOCKVUE_SKIP_MODEL_DOWNLOAD=1
