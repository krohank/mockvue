# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB. In development, if this is unreachable the server starts an
# in-memory MongoDB automatically (data is lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/mockvue
# ALLOW_IN_MEMORY_DB=true          # default: true except in production

# Auth. REQUIRED in production: a long random string (16+ chars), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── AI grading (optional) ────────────────────────────────────────────────────
# fallback = offline question bank + rubric evaluator (no key needed)
# gemini   = Google Gemini   (default model gemini-2.5-flash)
# openai   = OpenAI          (default model gpt-4o-mini)
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000

# ── Misc ─────────────────────────────────────────────────────────────────────
# SEED_DEMO_DATA=true              # demo accounts + sample sessions; default: true except in production
# SERVE_CLIENT=true                # serve client/dist from Express; default: true in production
# TRUST_PROXY=false                # set true behind a reverse proxy (correct client IPs for rate limiting)
CV_MONITORING_MODE=client
